import React, { useState, useEffect } from 'react';
import { useParams, Link, useNavigate } from 'react-router-dom';
import api from '../utils/api';
import { toast } from 'react-toastify';
import './OrganizerEventDetail.css';

const OrganizerEventDet          <h2>👥 Participants List ({filteredParticipants.length})</h2>
          <div className="header-actions">
            <button onClick={handleExportCSV} className="btn btn-primary">
              📊 Export CSV
            </button>
            <Link to={`/organizer/events/${eventId}/scanner`} className="btn btn-secondary">
              📷 QR Scanner
            </Link>
            {/* Edit button - navigates to the EditEvent page (organizer/admin only route is protected in App.js) */}
            <Link to={`/organizer/events/${eventId}/edit`} className="btn btn-primary">
              ✏️ Edit Event
            </Link>
            {event.eventType === 'Merchandise' && (
              <Link to={`/organizer/events/${eventId}/orders`} className="btn btn-secondary">
                📦 Manage Orders
              </Link>
            )}
          </div>
        </div>

        {/* Search and Filters */}nst { eventId } = useParams();
  const navigate = useNavigate();
  const [event, setEvent] = useState(null);
  const [participants, setParticipants] = useState([]);
  const [analytics, setAnalytics] = useState(null);
  const [loading, setLoading] = useState(true);
  const [searchQuery, setSearchQuery] = useState('');
  const [filterStatus, setFilterStatus] = useState('all');
  const [filterPayment, setFilterPayment] = useState('all');
  const [filterAttendance, setFilterAttendance] = useState('all');

  useEffect(() => {
    fetchEventDetails();
    fetchParticipants();
    fetchAnalytics();
  }, [eventId]);

  const fetchEventDetails = async () => {
    try {
      const { data } = await api.get(`/events/${eventId}`);
      setEvent(data.data);
    } catch (error) {
      console.error('Error fetching event:', error);
      toast.error('Failed to load event details');
    }
  };

  const fetchParticipants = async () => {
    try {
      const { data } = await api.get(`/events/${eventId}/participants`);
      setParticipants(data.data || []);
    } catch (error) {
      console.error('Error fetching participants:', error);
      toast.error('Failed to load participants');
    }
  };

  const fetchAnalytics = async () => {
    try {
      const { data } = await api.get(`/organizer/events/${eventId}/analytics`);
      setAnalytics(data.data);
      setLoading(false);
    } catch (error) {
      console.error('Error fetching analytics:', error);
      setLoading(false);
    }
  };

  const handleExportCSV = async () => {
    try {
      const response = await api.get(`/events/${eventId}/export-attendance`, {
        responseType: 'blob'
      });
      
      const url = window.URL.createObjectURL(new Blob([response.data]));
      const link = document.createElement('a');
      link.href = url;
      link.setAttribute('download', `${event?.name.replace(/\s+/g, '_')}_participants_${Date.now()}.csv`);
      document.body.appendChild(link);
      link.click();
      link.remove();
      
      toast.success('CSV exported successfully!');
    } catch (error) {
      console.error('Export error:', error);
      toast.error('Failed to export CSV');
    }
  };

  const filteredParticipants = participants.filter(p => {
    const matchesSearch = searchQuery === '' || 
      p.participant?.firstName?.toLowerCase().includes(searchQuery.toLowerCase()) ||
      p.participant?.lastName?.toLowerCase().includes(searchQuery.toLowerCase()) ||
      p.participant?.email?.toLowerCase().includes(searchQuery.toLowerCase()) ||
      p.ticketId?.toLowerCase().includes(searchQuery.toLowerCase());

    const matchesPayment = filterPayment === 'all' || p.paymentStatus === filterPayment;
    const matchesAttendance = filterAttendance === 'all' || 
      (filterAttendance === 'present' && p.attendance) ||
      (filterAttendance === 'absent' && !p.attendance);

    return matchesSearch && matchesPayment && matchesAttendance;
  });

  if (loading) {
    return <div className="loading">Loading event details...</div>;
  }

  if (!event) {
    return <div className="container"><p>Event not found</p></div>;
  }

  return (
    <div className="container organizer-event-detail-page">
      {/* Header with Back Button */}
      <div className="page-header">
        <button onClick={() => navigate('/organizer/dashboard')} className="btn btn-secondary">
          ← Back to Dashboard
        </button>
        <h1>{event.name}</h1>
      </div>

      {/* Event Overview Card */}
      <div className="event-overview card">
        <h2>📋 Event Overview</h2>
        <div className="overview-grid">
          <div className="overview-item">
            <span className="label">Event Type:</span>
            <span className="value">
              <span className={`type-badge ${event.eventType.toLowerCase()}`}>
                {event.eventType}
              </span>
            </span>
          </div>
          <div className="overview-item">
            <span className="label">Status:</span>
            <span className="value">
              <span className={`status-badge ${event.status.toLowerCase()}`}>
                {event.status}
              </span>
            </span>
          </div>
          <div className="overview-item">
            <span className="label">Start Date:</span>
            <span className="value">
              {new Date(event.startDate).toLocaleString('en-IN', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
              })}
            </span>
          </div>
          <div className="overview-item">
            <span className="label">End Date:</span>
            <span className="value">
              {new Date(event.endDate).toLocaleString('en-IN', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
              })}
            </span>
          </div>
          <div className="overview-item">
            <span className="label">Registration Deadline:</span>
            <span className="value">
              {new Date(event.registrationDeadline).toLocaleString('en-IN', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
              })}
            </span>
          </div>
          <div className="overview-item">
            <span className="label">Eligibility:</span>
            <span className="value">{event.eligibility}</span>
          </div>
          <div className="overview-item">
            <span className="label">Pricing:</span>
            <span className="value">₹{event.registrationFee}</span>
          </div>
          <div className="overview-item">
            <span className="label">Registration Limit:</span>
            <span className="value">{event.registrationLimit || 'Unlimited'}</span>
          </div>
        </div>

        <div className="event-description">
          <h3>Description</h3>
          <p>{event.description}</p>
        </div>
      </div>

      {/* Analytics Card */}
      <div className="analytics-section card">
        <div className="section-header">
          <h2>📊 Analytics & Insights</h2>
        </div>

        <div className="analytics-grid">
          <div className="analytics-card registrations">
            <div className="icon">👥</div>
            <div className="data">
              <h3>{event.registrationCount || 0}</h3>
              <p>Total {event.eventType === 'Merchandise' ? 'Orders' : 'Registrations'}</p>
              {event.registrationLimit && (
                <small>{((event.registrationCount / event.registrationLimit) * 100).toFixed(1)}% of capacity</small>
              )}
            </div>
          </div>

          <div className="analytics-card attendance">
            <div className="icon">✓</div>
            <div className="data">
              <h3>{analytics?.attendanceCount || 0}</h3>
              <p>Attendance Marked</p>
              {event.registrationCount > 0 && (
                <small>{((analytics?.attendanceCount || 0) / event.registrationCount * 100).toFixed(1)}% attendance rate</small>
              )}
            </div>
          </div>

          <div className="analytics-card revenue">
            <div className="icon">💰</div>
            <div className="data">
              <h3>₹{event.revenue || 0}</h3>
              <p>Revenue Generated</p>
              <small>From {analytics?.paidParticipants || 0} paid registrations</small>
            </div>
          </div>

          {event.eventType === 'Merchandise' && (
            <div className="analytics-card pending">
              <div className="icon">⏳</div>
              <div className="data">
                <h3>{analytics?.pendingPayments || 0}</h3>
                <p>Pending Approvals</p>
                <small>Payment proofs to review</small>
              </div>
            </div>
          )}

          {analytics?.teamStats && (
            <div className="analytics-card teams">
              <div className="icon">👨‍👩‍👧‍👦</div>
              <div className="data">
                <h3>{analytics.teamStats.totalTeams || 0}</h3>
                <p>Teams Registered</p>
                <small>{analytics.teamStats.completeTeams || 0} complete teams</small>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Participants List Card */}
      <div className="participants-section card">
        <div className="section-header">
          <h2>👥 Participants List ({filteredParticipants.length})</h2>
          <div className="header-actions">
            <button onClick={handleExportCSV} className="btn btn-primary">
              4E5 Export CSV
            </button>
            <Link to={`/organizer/events/${eventId}/scanner`} className="btn btn-secondary">
              4F7 QR Scanner
            </Link>
            {/* Edit button - navigates to the EditEvent page (organizer/admin only route is protected in App.js) */}
            <Link to={`/organizer/events/${eventId}/edit`} className="btn btn-primary">
              4DD Edit Event
            </Link>
            {event.eventType === 'Merchandise' && (
              <Link to={`/organizer/events/${eventId}/orders`} className="btn btn-secondary">
                4EDE0F Manage Orders
              </Link>
            )}
          </div>
        </div>

        {/* Search and Filters */}
        <div className="filters-bar">
          <div className="search-box">
            <input
              type="text"
              placeholder="Search by name, email, or ticket ID..."
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
            />
          </div>

          <div className="filter-group">
            <select value={filterPayment} onChange={(e) => setFilterPayment(e.target.value)}>
              <option value="all">All Payment Status</option>
              <option value="completed">Paid</option>
              <option value="pending">Pending</option>
              <option value="rejected">Rejected</option>
            </select>

            <select value={filterAttendance} onChange={(e) => setFilterAttendance(e.target.value)}>
              <option value="all">All Attendance</option>
              <option value="present">Present</option>
              <option value="absent">Absent</option>
            </select>

            {(searchQuery || filterPayment !== 'all' || filterAttendance !== 'all') && (
              <button 
                className="btn btn-secondary btn-sm"
                onClick={() => {
                  setSearchQuery('');
                  setFilterPayment('all');
                  setFilterAttendance('all');
                }}
              >
                Clear Filters
              </button>
            )}
          </div>
        </div>

        {/* Participants Table */}
        {filteredParticipants.length > 0 ? (
          <div className="participants-table-wrapper">
            <table className="participants-table">
              <thead>
                <tr>
                  <th>Ticket ID</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Contact</th>
                  <th>Reg. Date</th>
                  {event.eventType === 'Merchandise' && <th>Payment</th>}
                  {participants.some(p => p.team) && <th>Team</th>}
                  <th>Attendance</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {filteredParticipants.map((p) => (
                  <tr key={p._id}>
                    <td>
                      <code className="ticket-id">{p.ticketId}</code>
                    </td>
                    <td>
                      <strong>
                        {p.participant?.firstName} {p.participant?.lastName}
                      </strong>
                    </td>
                    <td>{p.participant?.email}</td>
                    <td>{p.participant?.contactNumber || 'N/A'}</td>
                    <td>
                      {new Date(p.registrationDate).toLocaleDateString('en-IN', {
                        day: '2-digit',
                        month: 'short',
                        year: 'numeric'
                      })}
                    </td>
                    {event.eventType === 'Merchandise' && (
                      <td>
                        <span className={`payment-status ${p.paymentStatus}`}>
                          {p.paymentStatus === 'completed' && '✓ Paid'}
                          {p.paymentStatus === 'pending' && '⏳ Pending'}
                          {p.paymentStatus === 'rejected' && '✗ Rejected'}
                        </span>
                      </td>
                    )}
                    {participants.some(p => p.team) && (
                      <td>{p.team || '-'}</td>
                    )}
                    <td>
                      {p.attendance ? (
                        <span className="attendance-badge present">
                          ✓ Present
                          <br />
                          <small>
                            {new Date(p.attendanceTime).toLocaleString('en-IN', {
                              hour: '2-digit',
                              minute: '2-digit',
                              day: '2-digit',
                              month: 'short'
                            })}
                          </small>
                        </span>
                      ) : (
                        <span className="attendance-badge absent">✗ Absent</span>
                      )}
                    </td>
                    <td>
                      <div className="action-buttons">
                        {p.customFormData && Object.keys(p.customFormData).length > 0 && (
                          <button 
                            className="btn-icon" 
                            title="View Custom Form Data"
                            onClick={() => {
                              alert(JSON.stringify(p.customFormData, null, 2));
                            }}
                          >
                            📝
                          </button>
                        )}
                        {event.eventType === 'Merchandise' && p.merchandiseOptions && (
                          <button 
                            className="btn-icon" 
                            title="View Merchandise Details"
                            onClick={() => {
                              const details = `Size: ${p.merchandiseOptions.size || 'N/A'}\nColor: ${p.merchandiseOptions.color || 'N/A'}\nVariant: ${p.merchandiseOptions.variant || 'N/A'}`;
                              alert(details);
                            }}
                          >
                            🛍️
                          </button>
                        )}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div className="no-data">
            <p>No participants found matching the filters</p>
          </div>
        )}
      </div>

      {/* Quick Stats Summary */}
      <div className="quick-stats card">
        <h3>Quick Stats</h3>
        <div className="stats-row">
          <div className="stat-item">
            <strong>Total Participants:</strong>
            <span>{participants.length}</span>
          </div>
          <div className="stat-item">
            <strong>Attendance Rate:</strong>
            <span>
              {participants.length > 0 
                ? `${((participants.filter(p => p.attendance).length / participants.length) * 100).toFixed(1)}%`
                : '0%'}
            </span>
          </div>
          {event.eventType === 'Merchandise' && (
            <>
              <div className="stat-item">
                <strong>Paid Orders:</strong>
                <span>{participants.filter(p => p.paymentStatus === 'completed').length}</span>
              </div>
              <div className="stat-item">
                <strong>Pending Approvals:</strong>
                <span>{participants.filter(p => p.paymentStatus === 'pending').length}</span>
              </div>
            </>
          )}
          {participants.some(p => p.team) && (
            <div className="stat-item">
              <strong>Team Registrations:</strong>
              <span>{participants.filter(p => p.team).length}</span>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default OrganizerEventDetail;
